#!/bin/sh
# Gradle start up script for POSIX - Gradle 8.11.1 wrapper.
#
# Minimal but functionally equivalent to the upstream script: run
# org.gradle.wrapper.GradleWrapperMain from gradle/wrapper/gradle-wrapper.jar.
# NOTE: the wrapper jar is a binary artifact produced by "gradle wrapper" -
# see runtime/README.md if it is missing.

APP_HOME=$(cd "$(dirname "$0")" && pwd)
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ -n "$JAVA_HOME" ] ; then
    JAVACMD=$JAVA_HOME/bin/java
else
    JAVACMD=java
fi

exec "$JAVACMD" -Xmx64m -Xms64m -Dorg.gradle.appname=gradlew \
    -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"