<?xml version="1.0" encoding="utf-8"?>
<!-- R13 (project3 sections 48-49): modern Android backend, API 21+. The launcher
     activity keeps the same orientation/config-change contract as the desktop
     window (landscape, no recreation on rotation/IME changes). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name">

        <!-- The launcher entry: unpacks the data pack behind a progress bar, then starts the game activity. -->
        <activity
            android:name=".PrepareActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
            android:exported="true"
            android:screenOrientation="landscape">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AndroidLauncher"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
            android:exported="false"
            android:screenOrientation="landscape" />
    </application>

</manifest>
